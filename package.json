{
  "name": "web-engineering-lab",
  "version": "1.0.0",
  "description": "Web Engineering laboratory work for Labs 01-03 and 05.",
  "main": "public/main.js",
  "scripts": {
    "test": "npm run build && node --test tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "audit:lab05": "node scripts/audit-lab05.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "start": "npm run build && serve public -l 3000"
  },
  "keywords": [
    "web-engineering",
    "html",
    "css",
    "javascript"
  ],
  "author": "Ziaullah Khan",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "serve": "^14.2.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
